# Palanca-OT filter buttons (appear above the packet list). Format: "enabled","label","filter","tooltip"
"TRUE","Modbus","modbus","All Modbus/TCP traffic"
"TRUE","Writes","modbus.func_code in {5,6,15,16}","Modbus WRITE requests and replies (FC 05/06/15/16)"
"TRUE","Unapproved writes","modbus.func_code in {5,6,15,16} && tcp.dstport == 502 && !(ip.src in {192.168.2.10,192.168.2.20})","Write REQUESTS from anyone except HMI-01 and ENG-WS"
"TRUE","Exceptions","modbus.exception_code","Modbus error replies (e.g. Illegal Data Address during enumeration)"
"TRUE","Big reads","modbus.func_code in {1,2,3,4} && modbus.reference_num > 99","Reads above the normal register map (enumeration)"
"TRUE","OPC UA","opcua","All OPC UA traffic"
"TRUE","SYN scan","tcp.flags.syn==1 && tcp.flags.ack==0","New TCP connection attempts - many to different ports = a scan"
"TRUE","ARP spoof","arp.duplicate-address-detected || arp.duplicate-address-frame","Two MACs claiming one IP"
"TRUE","Big to PLC","ip.dst in {192.168.1.10,192.168.1.11} && frame.len > 1000","Large frames sent to a PLC (program upload)"
"TRUE","Not normal","!(modbus || opcua || snmp || arp || http || tls || ntp || syslog || nbns || llmnr || ssdp || tcp.port in {80,443,502,4840})","Everything that is not part of the normal Palanca protocol mix"
