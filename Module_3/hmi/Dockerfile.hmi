FROM python:3.11-slim
# iproute2: Module 3 Day 4's setup.sh adds an 'ip route' for cross-zone
# traffic to reach fw-ot-01, needed once the HMI is single-homed on
# Supervisory only (see docker-compose.yml note on the flat-network fix).
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 iputils-ping \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir opcua==0.98.13
COPY hmi_sim.py /app/hmi_sim.py
WORKDIR /app
EXPOSE 4840 80
CMD ["python3", "hmi_sim.py"]
